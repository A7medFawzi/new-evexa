# Copy to .env.local (development) or set in your hosting dashboard (production).

# Public base URL used for metadata (openGraph / metadataBase).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form email
# Every submission is emailed to CONTACT_TO_EMAIL (Reply goes to the visitor).
# Configure ONE provider: Resend (RESEND_API_KEY) or SMTP (SMTP_*).
# With neither set (local development), submissions are saved to
# data/contact-submissions.ndjson instead.
# ---------------------------------------------------------------------------

# Where submissions are delivered (comma-separate for several addresses)
CONTACT_TO_EMAIL=
# Sender shown in the inbox, e.g. "EVEXA Website <website@evexa.tech>"
CONTACT_FROM_EMAIL=

# Option A — Resend (https://resend.com): API key
RESEND_API_KEY=

# Option B — SMTP (Google Workspace, Zoho, Outlook, hosting mailbox…)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
