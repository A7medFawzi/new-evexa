# Copy to .env.local (development) or set in your hosting dashboard (production).

# Public base URL used for metadata (openGraph / metadataBase).
# Production: https://evexa.tech (canonical URLs, hreflang, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form email
# Every submission is emailed to CONTACT_TO_EMAIL (Reply goes to the visitor).
# EVEXA uses Resend: set RESEND_API_KEY (SMTP_* is an alternative).
# With neither set (local development), submissions are saved to
# data/contact-submissions.ndjson instead.
# ---------------------------------------------------------------------------

# Where submissions are delivered (comma-separate for several addresses).
# The first address is also the Reply-To of the confirmation sent to the visitor.
CONTACT_TO_EMAIL=info@evexa.tech
# Sender shown in the inbox — its domain (evexa.tech) must be verified in Resend
CONTACT_FROM_EMAIL=EVEXA Team <info@evexa.tech>
# Visitors get an automatic "we received your message" email in their
# language (Arabic / English). Set to false to turn it off.
CONTACT_AUTO_REPLY=true

# Resend (https://resend.com) API key — keep it secret, never commit it
RESEND_API_KEY=

# Alternative — SMTP (only if not using Resend)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Website chat assistant (OpenRouter, or any OpenAI-compatible API).
# Without a key the chat button is hidden. Never commit the key.
# ---------------------------------------------------------------------------
CHATBOT_API_KEY=
# Chat-completions URL. Leave empty for OpenRouter.
CHATBOT_API_URL=
# OpenRouter model id, e.g. anthropic/claude-haiku-5.5 (paid, good Arabic)
# or google/gemma-4-31b-it:free (free, weak Arabic). Empty = the free Gemma.
CHATBOT_MODEL=
# Optional model tried once if the main one fails (OpenRouter default: openrouter/free).
CHATBOT_FALLBACK_MODEL=
# Optional secret that unlocks chat diagnostics (header x-chat-debug). Leave empty to disable.
CHATBOT_DEBUG_KEY=
